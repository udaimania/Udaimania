<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ATSApplicationFontsPath</key>
	<string>.</string>
	<key>CFBundleShortVersionString</key>
	<string>2.9.3</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(UDAIMANIA_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>144</string>
	<key>UdaimaniaBackendURL</key>
	<string>$(UDAIMANIA_BACKEND_URL)</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Udaimania uses Automation to focus or reopen your agent sessions in the terminal.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Udaimania listens while you talk to Flow about your plan. Audio is only used for that conversation.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Udaimania uses screen access to create your timeline. Recordings stay on your Mac and you can pause or delete them anytime.</string>
	<key>PHPostHogApiKey</key>
	<string>$(POSTHOG_API_KEY)</string>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>3600</integer>
	<key>UIAppFonts</key>
	<array>
		<string>InstrumentSerif-Regular.ttf</string>
		<string>InstrumentSerif-Italic.ttf</string>
		<string>Figtree-VariableFont_wght.ttf</string>
		<string>Figtree-Italic-VariableFont_wght.ttf</string>
		<string>Nunito-VariableFont_wght.ttf</string>
		<string>Nunito-Italic-VariableFont_wght.ttf</string>
	</array>
</dict>
</plist>
